# Copiá este archivo como .env.local

# Red de la custodia: localhost (nodo de Hardhat) o rskTestnet
CHAIN_NETWORK=localhost
# CHAIN_RPC_URL=https://public-node.testnet.rsk.co

# Solo para rskTestnet. En localhost se usan las cuentas de prueba de Hardhat.
# ARBITER_PRIVATE_KEY es la misma que DEPLOYER_PRIVATE_KEY de conforme/contracts/.env
# ARBITER_PRIVATE_KEY=0x...
# BUYER_PRIVATE_KEY=0x...
# SELLER_ADDRESS=0x...   (opcional: si falta, se usa la que guardó el deploy)

# Lectura de documentos con IA (opcional). Cualquier API compatible con OpenAI.
# Sin esto, los PDF con texto se leen por reglas y las imágenes no se aceptan.
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
