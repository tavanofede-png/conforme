# Copiá este archivo como .env (solo hace falta para rskTestnet).
# `npm run wallets` genera dos billeteras nuevas para pegar acá.

# Despliega los contratos y actúa como árbitro (el verificador que libera los pagos).
# Cargale tRBTC desde https://faucet.rootstock.io
DEPLOYER_PRIVATE_KEY=0x...

# Billetera del importador en la demo. El deploy le acuña tUSD y le manda gas.
BUYER_PRIVATE_KEY=0x...

# Opcional
# SELLER_ADDRESS=0x...
# RSK_TESTNET_RPC_URL=https://public-node.testnet.rsk.co
# MINT_TUSD=1000000
# BUYER_GAS_TOPUP=0.0003
